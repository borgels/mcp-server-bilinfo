# Bilinfo issues the credentials. Either pair is enough; a tool that needs the other one says so.
# User name and password of the Bilinfo API account (HTTP Basic): the dealer's vehicles for sale (Listing API).
BILINFO_USERNAME=
BILINFO_PASSWORD=
# Client id and secret registered with Bilinfo's authorization service (OAuth 2.0): every other service.
# BILINFO_CLIENT_ID=
# BILINFO_CLIENT_SECRET=
# The identifier Bilinfo allots a Case Plugin implementer. Only the status report of an application needs it.
# BILINFO_PLUGIN_ID=
# production (default) or qa: the environment of the services other than the Listing API.
# BILINFO_ENVIRONMENT=production
# GUID of one dealer: limits every read of vehicles to that dealer, and is the dealer whose users are shown.
# BILINFO_DEALER_ID=
# Base URL of the Listing API. Must be https on bilinfo.net (loopback http is allowed for local mocks).
# BILINFO_BASE_URL=https://gw.bilinfo.net/listingapi
# BILINFO_ALLOW_CUSTOM_BASE_URL=false
BILINFO_TIMEOUT_MS=30000
BILINFO_MAX_CONCURRENCY=4
# Largest response body read from Bilinfo (bytes, max 104857600). The whole list of vehicles is one response.
BILINFO_MAX_RESPONSE_BYTES=10485760

# Tools that change something in Bilinfo (the status report of an application) are disabled unless this is true.
BILINFO_ENABLE_WRITES=false
# Comma-separated tool names to disable (with or without the bilinfo_ prefix).
BILINFO_DISABLED_TOOLS=
# JSONL audit trail of tool calls (never what Bilinfo answered); write tools refuse to run if it cannot be written.
BILINFO_AUDIT_LOG=

# HTTP transport. A bearer token (>= 32 printable ASCII characters, e.g.
# `openssl rand -hex 32`) is required unless the server binds to loopback.
MCP_HTTP_TOKEN=
# Bind address (HOST is also read; MCP_HTTP_HOST wins):
# MCP_HTTP_HOST=127.0.0.1
# PORT=3000
# MCP_ALLOWED_ORIGINS=
# MCP_ALLOWED_HOSTS=
# MCP_MAX_BODY_BYTES=10485760
# MCP_AUTH_FAILURE_LIMIT=20
# MCP_AUTH_FAILURE_WINDOW_MS=60000
# Allow any browser origin (requires a token):
# MCP_ALLOW_ANY_ORIGIN=false
# Non-loopback bind without a token; isolated networks only:
# MCP_HTTP_ALLOW_UNAUTHENTICATED=false
